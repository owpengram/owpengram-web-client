VITE_LANG_PACK_VERSION=369363
VITE_MTPROTO_WORKER=1
VITE_MTPROTO_SW=
VITE_MTPROTO_HTTP=
VITE_MTPROTO_HTTP_UPLOAD=
VITE_MTPROTO_AUTO=1
# Off for owpengram-server, which speaks MTProto over raw TCP (unreachable from
# a browser) and over WebSocket only -- it serves no /apiw1 HTTP endpoint at
# all. Left on, VITE_MTPROTO_AUTO makes Modes.multipleTransports start every
# connection on HTTP (see src/config/modes.ts), so every request 404s before
# the WebSocket transport is ever tried.
VITE_MTPROTO_HAS_HTTP=
VITE_MTPROTO_HAS_WS=1
# Which owpengram-server this build talks to -- see src/config/owpengram.ts.
# Override per machine in .env.local (git-ignored), which scripts/owpengram-web.ps1
# writes for you; don't edit this line for a one-off address.
VITE_OWPENGRAM_SERVER=127.0.0.1:2398
VITE_SAFARI_PROXY_WEBSOCKET=
PRODUCTION_BUILD_VERSION=2.1.4
